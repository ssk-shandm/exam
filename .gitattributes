* text=auto eol=lf

# Keep documentation out of the language breakdown.
*.md linguist-documentation

# Configuration and data files are not application source code.
*.json linguist-detectable=false
*.toml linguist-detectable=false
*.conf linguist-detectable=false

# Dependency lockfiles are generated metadata.
*.lock linguist-generated

# Generated build output and generated question-bank data.
dist/** linguist-generated
.tmp-build/** linguist-generated
public/subjects/** linguist-generated
